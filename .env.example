# ============================================================
# NasDeck Docker Compose 环境变量
#
# 首次部署：
#   cp .env.example .env
#   填写 POSTGRES_PASSWORD 与 SECRET_KEY，其余保持默认即可
#   docker compose up -d --build
#
# 应用容器的全部配置都通过本文件注入，代码里不写死任何部署相关地址。
# ============================================================

# ---------- 访问 ----------
# 宿主机访问端口；容器内部固定监听 80
APP_PORT=5000

# ---------- 数据库 ----------
# 仅在 PostgreSQL 数据卷首次创建时生效；已有数据卷时修改不会改变数据库账号
POSTGRES_DB=nasdeck
POSTGRES_USER=nasdeck

# 必填。建议用 openssl rand -hex 24 生成十六进制密码，
# 避免 @ : / 等字符破坏 DATABASE_URL
POSTGRES_PASSWORD=

# ---------- 应用 ----------
APP_NAME=NasDeck
TZ=Asia/Shanghai

# 必填。JWT 签名密钥，用 openssl rand -hex 32 生成
# 不设置或随意更换会导致重启后所有登录状态失效
SECRET_KEY=

# 登录令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# false：仅首个用户可注册并自动成为管理员；true：开放后续注册
REGISTRATION_OPEN=false

# 允许跨域的来源，逗号分隔；前后端同源部署通常留空
CORS_ORIGINS=

# ---------- 数据目录 ----------
# 宿主机数据目录，相对路径以本文件所在目录为准
DATA_DIR=./data

# ---------- 应用市场与自动化方案 ----------
# 配套管理端 nas-deck-manage 的对外地址，必须是 app 容器可访问的地址。
# 镜像构建时已写入默认值（CI 为 https://deck-m.freeapps.uk），
# 只有需要指向其他管理端时才在这里覆盖；留空会覆盖成空值并关闭同步。
# MANAGE_BASE_URL=https://deck-m.freeapps.uk

# 同步间隔（分钟）
MANAGE_SYNC_INTERVAL_MINUTES=30

# 启动时立即同步一次
MANAGE_SYNC_ON_STARTUP=true
