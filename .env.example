# PostgreSQL 密码（docker compose 部署必填，postgres 服务与 backend 共用）
POSTGRES_PASSWORD=please-change-me

# 数据库连接字符串
# - docker compose 部署：无需配置，compose 已按下方格式注入，指向 postgres 服务
#   postgresql+asyncpg://nasdeck:${POSTGRES_PASSWORD}@postgres:5432/nasdeck
# - 本地开发（数据库跑在宿主机 5434 端口，见 CLAUDE.md）：
#   DATABASE_URL=postgresql+asyncpg://nasdeck:nasdeck@localhost:5434/nasdeck
DATABASE_URL=postgresql+asyncpg://nasdeck:nasdeck@localhost:5434/nasdeck

# JWT 签名密钥。不配置时后端会自动生成随机密钥并打印告警（重启后旧 token 全部失效），
# 生产环境务必设置为固定随机字符串，例如：openssl rand -hex 32
SECRET_KEY=

# 数据根目录（容器内固定为 /data，挂载宿主机 ./data；本地开发默认 ./data）
DATA_ROOT=/data
# 说明：系统设置-存储配置中的存储目录（含应用数据目录），其宿主机路径需额外挂载进
# backend 容器（在 docker-compose.yml 的 backend.volumes 中添加，如 - /mnt/disk1:/mnt/disk1），
# 否则后端无法浏览/新建其中的子目录，保存存储目录时也会因容器内不可见而校验失败。

# 服务概览跳转链接使用的访问地址（内网 IP 或域名，如 192.168.1.17）
# 留空时自动探测本机内网 IP；docker compose 部署时容器内只能探测到容器地址，
# 若通过 localhost 访问概览且需要跳转到内网地址，请显式配置此项
ACCESS_HOST=

# 注册开关：true 开放注册；false 时仅首个用户（自动成为管理员）可注册
REGISTRATION_OPEN=false

# 允许的跨域来源，逗号分隔；留空表示不限制（开发默认值）
CORS_ORIGINS=

# 访问令牌过期时间（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 配套管理端（nas-deck-manage）基础地址：后端会定时从其拉取应用市场与自动化方案
# 作为本地只读缓存；留空表示禁用同步，保持纯本地行为
# MANAGE_BASE_URL=http://192.168.1.17:5101
MANAGE_BASE_URL=

# 从管理端同步应用市场与自动化方案的间隔（分钟）
MANAGE_SYNC_INTERVAL_MINUTES=30

# 启动时是否立即同步一次应用市场与自动化方案
MANAGE_SYNC_ON_STARTUP=true

# 授权证书 Ed25519 公钥（PEM，可用 \n 表示换行）；留空时从管理端获取并缓存
LICENSE_PUBLIC_KEY=

# 后台刷新授权证书的间隔（小时），默认 24 小时
LICENSE_REFRESH_INTERVAL_HOURS=24

# 授权管理端请求超时（秒）
LICENSE_HTTP_TIMEOUT_SECONDS=15
