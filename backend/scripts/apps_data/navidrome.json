{
  "name": "navidrome",
  "display_name": "Navidrome",
  "description": "Navidrome 是开源的个人音乐流媒体服务器，兼容 Subsonic API，可通过网页和各类客户端随时随地播放你的音乐收藏，打造属于自己的私人音乐库。",
  "category": "music",
  "tags": [
    "音乐",
    "流媒体",
    "音乐服务器",
    "Subsonic",
    "开源"
  ],
  "website": "https://www.navidrome.org/",
  "source_url": "https://github.com/navidrome/navidrome",
  "architectures": [
    "amd64",
    "arm64"
  ],
  "image": "deluan/navidrome",
  "default_ports": [
    {
      "port": 4533,
      "protocol": "tcp",
      "description": "Web 界面与 Subsonic API"
    }
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "ports",
      "volumes",
      "navidrome_env"
    ],
    "containers": [
      {
        "name": "navidrome",
        "title": "Navidrome",
        "settings": [
          {
            "type": "ports",
            "title": "端口设置",
            "fields": [
              "ports"
            ]
          },
          {
            "type": "volumes",
            "title": "存储空间设置",
            "fields": [
              "volumes"
            ]
          },
          {
            "type": "env",
            "title": "环境变量",
            "fields": [
              "navidrome_env"
            ]
          },
          {
            "type": "advanced",
            "title": "高级设置",
            "fields": [
              "privileged"
            ]
          }
        ],
        "description": "Navidrome 私人音乐流媒体服务器"
      }
    ],
    "properties": {
      "ports": {
        "type": "array",
        "title": "端口设置",
        "items": {
          "type": "object",
          "required": [
            "local_port",
            "container_port",
            "protocol"
          ],
          "properties": {
            "protocol": {
              "enum": [
                "tcp",
                "udp"
              ],
              "type": "string",
              "title": "协议",
              "default": "tcp"
            },
            "local_port": {
              "type": "integer",
              "title": "本地端口",
              "maximum": 65535,
              "minimum": 1
            },
            "container_port": {
              "type": "integer",
              "title": "容器端口",
              "maximum": 65535,
              "minimum": 1
            }
          }
        },
        "default": [
          {
            "protocol": "tcp",
            "local_port": 4533,
            "container_port": 4533
          }
        ]
      },
      "volumes": {
        "type": "array",
        "title": "存储空间设置",
        "items": {
          "type": "object",
          "required": [
            "host_path",
            "container_path",
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "rw",
                "ro"
              ],
              "type": "string",
              "title": "权限",
              "default": "rw"
            },
            "host_path": {
              "type": "string",
              "title": "本地路径",
              "format": "directory"
            },
            "container_path": {
              "type": "string",
              "title": "容器路径"
            }
          }
        },
        "default": [
          {
            "mode": "rw",
            "host_path": "navidrome/data",
            "container_path": "/data"
          },
          {
            "mode": "ro",
            "host_path": "music",
            "container_path": "/music"
          }
        ]
      },
      "privileged": {
        "type": "boolean",
        "title": "特权模式",
        "default": false,
        "description": "以特权模式运行容器，可访问宿主机全部设备，一般无需开启"
      },
      "navidrome_env": {
        "type": "array",
        "title": "环境变量",
        "items": {
          "type": "object",
          "required": [
            "key",
            "value"
          ],
          "properties": {
            "key": {
              "type": "string",
              "title": "变量名"
            },
            "value": {
              "type": "string",
              "title": "值"
            }
          }
        },
        "default": [
          {
            "key": "TZ",
            "value": "Asia/Shanghai"
          }
        ]
      }
    }
  },
  "yaml_template": "services:\n  navidrome:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in navidrome_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
  "readme": "# Navidrome\n\nNavidrome 是开源的个人音乐流媒体服务器，兼容 Subsonic API，支持网页播放和丰富的手机/桌面客户端（如音流、Tempo、Symfonium 等）。\n\n## 部署前准备\n\n1. 在「存储空间设置」中将 `/music` 对应的本地路径修改为你 NAS 上的音乐库目录（建议填绝对路径，权限可保持 `ro` 只读）。\n2. `/data` 用于保存 Navidrome 的配置、数据库与缓存，保持默认即可。\n3. 部署完成后访问 `http://<NAS-IP>:4533`，首次打开需创建管理员账号。\n\n## 客户端连接\n\n任意兼容 Subsonic API 的客户端均可连接，服务器地址填 `http://<NAS-IP>:4533`，使用刚才创建的账号登录。",
  "version": "1.0.0",
  "type": "compose",
  "changelog": "初始导入",
  "backup_paths": [
    "/data"
  ],
  "is_builtin": false
}
