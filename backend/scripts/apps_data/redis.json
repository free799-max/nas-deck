{
    "name": "redis",
    "display_name": "Redis",
    "description": "Redis 是高性能的开源内存键值数据库，常用作缓存服务以提升应用响应速度，是 MoviePilot 等影视自动化工具以及各类自托管应用的常用缓存与队列后端。",
    "category": "tool",
    "tags": ["缓存", "Redis", "数据库", "基础服务", "开源"],
    "website": "https://redis.io/",
    "source_url": "https://github.com/redis/redis",
    "architectures": ["amd64", "arm64"],
    "image": "redis:7-alpine",
    "default_ports": [
        {"port": 6379, "protocol": "tcp", "description": "Redis 服务端口"}
    ],
    "config_schema": {
        "type": "object",
        "required": ["ports", "volumes"],
        "containers": [
            {
                "name": "redis",
                "title": "Redis",
                "settings": [
                    {"type": "ports", "title": "端口设置", "fields": ["ports"]},
                    {"type": "volumes", "title": "存储空间设置", "fields": ["volumes"]},
                    {"type": "env", "title": "环境变量", "fields": ["redis_env"]},
                    {"type": "advanced", "title": "高级设置", "fields": ["privileged"]}
                ],
                "description": "Redis 内存缓存数据库"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["local_port", "container_port", "protocol"],
                    "properties": {
                        "protocol": {"enum": ["tcp", "udp"], "type": "string", "title": "协议", "default": "tcp"},
                        "local_port": {"type": "integer", "title": "本地端口", "maximum": 65535, "minimum": 1},
                        "container_port": {"type": "integer", "title": "容器端口", "maximum": 65535, "minimum": 1}
                    }
                },
                "title": "端口设置",
                "default": [
                    {"protocol": "tcp", "local_port": 6379, "container_port": 6379}
                ]
            },
            "volumes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["host_path", "container_path", "mode"],
                    "properties": {
                        "mode": {"enum": ["rw", "ro"], "type": "string", "title": "权限", "default": "rw"},
                        "host_path": {"type": "string", "title": "本地路径", "format": "directory"},
                        "container_path": {"type": "string", "title": "容器路径"}
                    }
                },
                "title": "存储空间设置",
                "default": [
                    {"mode": "rw", "host_path": "redis/data", "container_path": "/data"}
                ]
            },
            "redis_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["key", "value"],
                    "properties": {
                        "key": {"type": "string", "title": "变量名"},
                        "value": {"type": "string", "title": "值"}
                    }
                },
                "title": "环境变量",
                "default": [
                    {"key": "TZ", "value": "Asia/Shanghai"}
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": false,
                "description": "一般无需开启"
            }
        }
    },
    "yaml_template": "services:\n  redis:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n{%- if redis_env %}\n    environment:\n{%- for item in redis_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n{%- endif %}\n",
    "readme": "# Redis\n\nRedis 是高性能的开源内存键值数据库，常用作缓存服务，可显著提升 MoviePilot 等应用的响应速度。\n\n## 部署前准备\n\n1. 默认端口 `6379`，如有冲突请在「端口设置」中修改本地端口。\n2. 数据目录 `/data` 已默认持久化，用于存放 RDB/AOF 持久化文件。\n\n## 使用\n\n- 连接地址：`<NAS-IP>:6379`，在需要缓存的应用（如 MoviePilot）中填写即可。\n- 默认未设置访问密码，仅限内网使用，请勿将端口暴露到公网；如需密码可通过启动参数 `--requirepass` 追加配置。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": ["/data"],
    "is_builtin": false
}
