{
    "name": "audiobookshelf",
    "display_name": "Audiobookshelf",
    "description": "Audiobookshelf 是自托管的有声书与播客服务器，支持多用户、播放进度跨设备同步，并提供 iOS / Android 移动客户端。",
    "category": "book",
    "tags": [
        "有声书",
        "播客",
        "音频",
        "媒体服务器",
        "开源"
    ],
    "website": "https://www.audiobookshelf.org/",
    "source_url": "https://github.com/advplyr/audiobookshelf",
    "architectures": [
        "amd64",
        "arm64"
    ],
    "image": "ghcr.io/advplyr/audiobookshelf",
    "default_ports": [
        {
            "port": 13378,
            "protocol": "tcp",
            "description": "Web 界面"
        }
    ],
    "config_schema": {
        "type": "object",
        "required": [
            "ports",
            "volumes",
            "audiobookshelf_env"
        ],
        "containers": [
            {
                "name": "audiobookshelf",
                "title": "Audiobookshelf",
                "settings": [
                    {
                        "type": "ports",
                        "title": "端口设置",
                        "fields": [
                            "ports"
                        ]
                    },
                    {
                        "type": "volumes",
                        "title": "存储空间设置",
                        "fields": [
                            "volumes"
                        ]
                    },
                    {
                        "type": "env",
                        "title": "环境变量",
                        "fields": [
                            "audiobookshelf_env"
                        ]
                    },
                    {
                        "type": "advanced",
                        "title": "高级设置",
                        "fields": [
                            "privileged"
                        ]
                    }
                ],
                "description": "Audiobookshelf 有声书服务器"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "local_port",
                        "container_port",
                        "protocol"
                    ],
                    "properties": {
                        "protocol": {
                            "enum": [
                                "tcp",
                                "udp"
                            ],
                            "type": "string",
                            "title": "协议",
                            "default": "tcp"
                        },
                        "local_port": {
                            "type": "integer",
                            "title": "本地端口",
                            "maximum": 65535,
                            "minimum": 1
                        },
                        "container_port": {
                            "type": "integer",
                            "title": "容器端口",
                            "maximum": 65535,
                            "minimum": 1
                        }
                    }
                },
                "title": "端口设置",
                "default": [
                    {
                        "protocol": "tcp",
                        "local_port": 13378,
                        "container_port": 13378
                    }
                ]
            },
            "volumes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "host_path",
                        "container_path",
                        "mode"
                    ],
                    "properties": {
                        "mode": {
                            "enum": [
                                "rw",
                                "ro"
                            ],
                            "type": "string",
                            "title": "权限",
                            "default": "rw"
                        },
                        "host_path": {
                            "type": "string",
                            "title": "本地路径",
                            "format": "directory"
                        },
                        "container_path": {
                            "type": "string",
                            "title": "容器路径"
                        }
                    }
                },
                "title": "存储空间设置",
                "default": [
                    {
                        "mode": "rw",
                        "host_path": "audiobookshelf/config",
                        "container_path": "/config"
                    },
                    {
                        "mode": "rw",
                        "host_path": "audiobookshelf/metadata",
                        "container_path": "/metadata"
                    },
                    {
                        "mode": "rw",
                        "host_path": "audiobookshelf/audiobooks",
                        "container_path": "/audiobooks"
                    }
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": false,
                "description": "一般情况下无需开启，仅当应用需要访问宿主机硬件设备时启用"
            },
            "audiobookshelf_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "key",
                        "value"
                    ],
                    "properties": {
                        "key": {
                            "type": "string",
                            "title": "变量名"
                        },
                        "value": {
                            "type": "string",
                            "title": "值"
                        }
                    }
                },
                "title": "环境变量",
                "default": [
                    {
                        "key": "TZ",
                        "value": "Asia/Shanghai"
                    }
                ]
            }
        }
    },
    "yaml_template": "services:\n  audiobookshelf:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in audiobookshelf_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
    "readme": "# Audiobookshelf\n\nAudiobookshelf 是自托管的有声书与播客服务器。它自动扫描你的有声书目录、匹配元数据与封面，支持多用户和播放进度跨设备同步，并有官方 iOS / Android 客户端。\n\n## 部署前准备\n\n1. 在「存储空间设置」中确认三个目录：`/config`（配置与数据库）、`/metadata`（封面与元数据缓存）、`/audiobooks`（有声书文件）。\n2. 如有播客需求，可再添加一个目录挂载到容器（如 `/podcasts`）并在应用内添加播客库。\n3. 部署完成后访问 `http://<NAS-IP>:13378`，首次进入创建管理员账号，然后添加媒体库。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": [
        "/config",
        "/metadata"
    ],
    "is_builtin": false
}