{
    "name": "siyuan",
    "display_name": "思源笔记",
    "description": "思源笔记是隐私优先的个人知识管理系统，支持块级引用、双向链接与 Markdown，本镜像在浏览器中提供完整的笔记工作空间。",
    "category": "tool",
    "tags": [
        "笔记",
        "知识管理",
        "Markdown",
        "双链",
        "开源"
    ],
    "website": "https://b3log.org/siyuan/",
    "source_url": "https://github.com/siyuan-note/siyuan",
    "architectures": [
        "amd64",
        "arm64"
    ],
    "image": "b3log/siyuan",
    "default_ports": [
        {
            "port": 6806,
            "protocol": "tcp",
            "description": "Web 界面"
        }
    ],
    "config_schema": {
        "type": "object",
        "required": [
            "ports",
            "volumes",
            "siyuan_env",
            "access_auth_code"
        ],
        "containers": [
            {
                "name": "思源笔记",
                "title": "思源笔记",
                "settings": [
                    {
                        "type": "ports",
                        "title": "端口设置",
                        "fields": [
                            "ports"
                        ]
                    },
                    {
                        "type": "volumes",
                        "title": "存储空间设置",
                        "fields": [
                            "volumes"
                        ]
                    },
                    {
                        "type": "env",
                        "title": "环境变量",
                        "fields": [
                            "siyuan_env"
                        ]
                    },
                    {
                        "type": "advanced",
                        "title": "高级设置",
                        "fields": [
                            "access_auth_code",
                            "privileged"
                        ]
                    }
                ],
                "description": "思源笔记工作空间"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "local_port",
                        "container_port",
                        "protocol"
                    ],
                    "properties": {
                        "protocol": {
                            "enum": [
                                "tcp",
                                "udp"
                            ],
                            "type": "string",
                            "title": "协议",
                            "default": "tcp"
                        },
                        "local_port": {
                            "type": "integer",
                            "title": "本地端口",
                            "maximum": 65535,
                            "minimum": 1
                        },
                        "container_port": {
                            "type": "integer",
                            "title": "容器端口",
                            "maximum": 65535,
                            "minimum": 1
                        }
                    }
                },
                "title": "端口设置",
                "default": [
                    {
                        "protocol": "tcp",
                        "local_port": 6806,
                        "container_port": 6806
                    }
                ]
            },
            "volumes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "host_path",
                        "container_path",
                        "mode"
                    ],
                    "properties": {
                        "mode": {
                            "enum": [
                                "rw",
                                "ro"
                            ],
                            "type": "string",
                            "title": "权限",
                            "default": "rw"
                        },
                        "host_path": {
                            "type": "string",
                            "title": "本地路径",
                            "format": "directory"
                        },
                        "container_path": {
                            "type": "string",
                            "title": "容器路径"
                        }
                    }
                },
                "title": "存储空间设置",
                "default": [
                    {
                        "mode": "rw",
                        "host_path": "siyuan/workspace",
                        "container_path": "/siyuan/workspace"
                    }
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": false,
                "description": "一般情况下无需开启，仅当应用需要访问宿主机硬件设备时启用"
            },
            "siyuan_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "key",
                        "value"
                    ],
                    "properties": {
                        "key": {
                            "type": "string",
                            "title": "变量名"
                        },
                        "value": {
                            "type": "string",
                            "title": "值"
                        }
                    }
                },
                "title": "环境变量",
                "default": [
                    {
                        "key": "TZ",
                        "value": "Asia/Shanghai"
                    }
                ]
            },
            "access_auth_code": {
                "type": "string",
                "title": "访问授权码",
                "default": "nasdeck123",
                "minLength": 4,
                "description": "浏览器访问思源笔记时需要输入的授权码，请务必修改为强密码"
            }
        }
    },
    "yaml_template": "services:\n  siyuan:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    command: [\"--workspace=/siyuan/workspace/\", \"--accessAuthCode={{ access_auth_code }}\"]\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in siyuan_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
    "readme": "# 思源笔记\n\n思源笔记是一款隐私优先的个人知识管理系统，支持完全离线使用与端到端加密同步，以块为单位组织内容，内置块级引用与双向链接。\n\n## 部署前准备\n\n1. 在「高级设置」中设置「访问授权码」（对应启动参数 `--accessAuthCode`），浏览器打开时需要输入，请务必使用强密码。\n2. 在「存储空间设置」中确认 `/siyuan/workspace`（笔记数据）的本地路径。\n3. 部署完成后访问 `http://<NAS-IP>:6806`，输入授权码即可进入工作空间。\n\n## 提示\n\n所有笔记数据保存在工作空间目录中，备份该目录即可完整迁移。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": [
        "/siyuan/workspace"
    ],
    "is_builtin": false
}