{
  "name": "easyvoice",
  "display_name": "EasyVoice",
  "description": "EasyVoice 是开源的智能文本转语音（TTS）工具，支持超长文本一键转语音、多角色配音、AI 智能推荐音色与流式播放，免费无字数限制。",
  "category": "tool",
  "tags": ["工具", "TTS", "文字转语音", "配音", "开源"],
  "website": "https://easyvoice.ioplus.tech/",
  "source_url": "https://github.com/cosin2077/easyVoice",
  "architectures": ["amd64"],
  "image": "cosincox/easyvoice",
  "default_ports": [
    {"port": 3000, "protocol": "tcp", "description": "Web 界面"}
  ],
  "config_schema": {
    "type": "object",
    "required": ["ports", "volumes", "easyvoice_env"],
    "containers": [
      {
        "name": "easyvoice",
        "title": "EasyVoice",
        "settings": [
          {"type": "ports", "title": "端口设置", "fields": ["ports"]},
          {"type": "volumes", "title": "存储空间设置", "fields": ["volumes"]},
          {"type": "env", "title": "环境变量", "fields": ["easyvoice_env"]},
          {"type": "advanced", "title": "高级设置", "fields": ["privileged"]}
        ],
        "description": "EasyVoice 智能文本转语音工具"
      }
    ],
    "properties": {
      "ports": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["local_port", "container_port", "protocol"],
          "properties": {
            "protocol": {
              "enum": ["tcp", "udp"],
              "type": "string",
              "title": "协议",
              "default": "tcp"
            },
            "local_port": {
              "type": "integer",
              "title": "本地端口",
              "maximum": 65535,
              "minimum": 1
            },
            "container_port": {
              "type": "integer",
              "title": "容器端口",
              "maximum": 65535,
              "minimum": 1
            }
          }
        },
        "title": "端口设置",
        "default": [
          {"protocol": "tcp", "local_port": 3000, "container_port": 3000}
        ]
      },
      "volumes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["host_path", "container_path", "mode"],
          "properties": {
            "mode": {
              "enum": ["rw", "ro"],
              "type": "string",
              "title": "权限",
              "default": "rw"
            },
            "host_path": {
              "type": "string",
              "title": "本地路径",
              "format": "directory"
            },
            "container_path": {
              "type": "string",
              "title": "容器路径"
            }
          }
        },
        "title": "存储空间设置",
        "default": [
          {"mode": "rw", "host_path": "easyvoice/audio", "container_path": "/app/audio"}
        ]
      },
      "privileged": {
        "type": "boolean",
        "title": "特权模式",
        "default": false,
        "description": "一般无需开启，仅在有特殊系统调用需求时启用"
      },
      "easyvoice_env": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": {"type": "string", "title": "变量名"},
            "value": {"type": "string", "title": "值"}
          }
        },
        "title": "环境变量",
        "default": [
          {"key": "TZ", "value": "Asia/Shanghai"}
        ]
      }
    }
  },
  "yaml_template": "services:\n  easyvoice:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in easyvoice_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
  "readme": "# EasyVoice\n\nEasyVoice 是开源的智能文本转语音（TTS）工具，默认使用 Edge-TTS 免费语音引擎，支持 10 万字以上长文本一键转语音与字幕、多角色自动配音、AI 推荐音色和流式播放，完全免费、无时长和字数限制。\n\n## 部署前准备\n\n1. 确认「EasyVoice 挂载」中的音频目录（容器内 `/app/audio`），生成的语音文件会持久化到这里。\n2. 如需使用自有语音模型，可在环境变量中配置 `OPENAI_BASE_URL`、`MODEL_NAME` 等 OpenAI 兼容接口参数。\n\n## 使用说明\n\n1. 部署完成后访问 `http://<NAS-IP>:3000` 打开 Web 界面。\n2. 粘贴文本后可为不同角色分配音色，生成前支持试听。\n3. 同时提供 HTTP API，可与其他应用集成。",
  "version": "1.0.0",
  "type": "compose",
  "backup_paths": ["/app/audio"],
  "is_builtin": false
}
