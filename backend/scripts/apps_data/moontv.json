{
    "name": "moontv",
    "display_name": "MoonTV",
    "description": "MoonTV 是一个开箱即用、跨平台的在线影视聚合播放器，内置多源搜索与播放，界面精美，支持收藏、播放记录与 PWA，部署后通过访问密码即可在网页端流畅观影。",
    "category": "movie",
    "tags": ["影视", "在线播放", "聚合", "播放器", "开源"],
    "website": "https://github.com/senshinya/MoonTV",
    "source_url": "https://github.com/senshinya/MoonTV",
    "architectures": ["amd64", "arm64"],
    "image": "ghcr.io/senshinya/moontv",
    "default_ports": [
        {"port": 3000, "protocol": "tcp", "description": "Web 访问端口"}
    ],
    "config_schema": {
        "type": "object",
        "required": ["ports", "moontv_env"],
        "containers": [
            {
                "name": "moontv",
                "title": "MoonTV",
                "settings": [
                    {"type": "ports", "title": "端口设置", "fields": ["ports"]},
                    {"type": "env", "title": "环境变量", "fields": ["moontv_env"]},
                    {"type": "advanced", "title": "高级设置", "fields": ["privileged"]}
                ],
                "description": "MoonTV 在线影视聚合播放器"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["local_port", "container_port", "protocol"],
                    "properties": {
                        "protocol": {"enum": ["tcp", "udp"], "type": "string", "title": "协议", "default": "tcp"},
                        "local_port": {"type": "integer", "title": "本地端口", "maximum": 65535, "minimum": 1},
                        "container_port": {"type": "integer", "title": "容器端口", "maximum": 65535, "minimum": 1}
                    }
                },
                "title": "端口设置",
                "default": [
                    {"protocol": "tcp", "local_port": 3000, "container_port": 3000}
                ]
            },
            "moontv_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["key", "value"],
                    "properties": {
                        "key": {"type": "string", "title": "变量名"},
                        "value": {"type": "string", "title": "值"}
                    }
                },
                "title": "环境变量",
                "default": [
                    {"key": "PASSWORD", "value": "moontv123"},
                    {"key": "TZ", "value": "Asia/Shanghai"}
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": false,
                "description": "一般无需开启"
            }
        }
    },
    "yaml_template": "services:\n  moontv:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n{%- if moontv_env %}\n    environment:\n{%- for item in moontv_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n{%- endif %}\n",
    "readme": "# MoonTV\n\nMoonTV 是一个开箱即用、跨平台的在线影视聚合播放器，内置多源搜索与播放，支持收藏、播放记录和 PWA，手机、平板、电脑浏览器均可使用。\n\n## 部署前准备\n\n1. 在「环境变量」中设置访问密码 `PASSWORD`（默认 `moontv123`，**请务必修改为自己的密码**）。\n2. 默认端口 `3000`，如有冲突请修改本地端口。\n\n## 使用\n\n部署完成后访问 `http://<NAS-IP>:3000`，输入访问密码即可进入。默认使用浏览器 LocalStorage 存储播放记录与收藏，无需额外数据库；如有多用户需求可自行扩展配置。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": [],
    "is_builtin": false
}
