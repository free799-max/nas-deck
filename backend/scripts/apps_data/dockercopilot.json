{
    "name": "dockercopilot",
    "display_name": "DockerCopilot",
    "description": "DockerCopilot 是一款主打便捷的 Docker 容器管理工具，支持一键更新容器、指定镜像和 tag 更新、容器启停、清理无 tag 镜像以及备份恢复容器配置。",
    "category": "docker",
    "tags": [
        "docker",
        "容器更新",
        "一键升级",
        "容器管理",
        "开源"
    ],
    "website": "https://hub.docker.com/r/0nlylty/dockercopilot",
    "source_url": "https://github.com/onlyLTY/dockerCopilot",
    "architectures": [
        "amd64",
        "arm64"
    ],
    "image": "0nlylty/dockercopilot",
    "default_ports": [
        {
            "port": 12712,
            "protocol": "tcp",
            "description": "Web 管理界面"
        }
    ],
    "config_schema": {
        "type": "object",
        "required": [
            "ports",
            "volumes",
            "dockercopilot_env"
        ],
        "containers": [
            {
                "name": "dockercopilot",
                "title": "DockerCopilot",
                "settings": [
                    {
                        "type": "ports",
                        "title": "端口设置",
                        "fields": [
                            "ports"
                        ]
                    },
                    {
                        "type": "volumes",
                        "title": "存储空间设置",
                        "fields": [
                            "volumes"
                        ]
                    },
                    {
                        "type": "env",
                        "title": "环境变量",
                        "fields": [
                            "dockercopilot_env"
                        ]
                    },
                    {
                        "type": "advanced",
                        "title": "高级设置",
                        "fields": [
                            "privileged"
                        ]
                    }
                ],
                "description": "DockerCopilot 一键更新容器工具"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "local_port",
                        "container_port",
                        "protocol"
                    ],
                    "properties": {
                        "protocol": {
                            "enum": [
                                "tcp",
                                "udp"
                            ],
                            "type": "string",
                            "title": "协议",
                            "default": "tcp"
                        },
                        "local_port": {
                            "type": "integer",
                            "title": "本地端口",
                            "maximum": 65535,
                            "minimum": 1
                        },
                        "container_port": {
                            "type": "integer",
                            "title": "容器端口",
                            "maximum": 65535,
                            "minimum": 1
                        }
                    }
                },
                "title": "端口设置",
                "default": [
                    {
                        "protocol": "tcp",
                        "local_port": 12712,
                        "container_port": 12712
                    }
                ]
            },
            "volumes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "host_path",
                        "container_path",
                        "mode"
                    ],
                    "properties": {
                        "mode": {
                            "enum": [
                                "rw",
                                "ro"
                            ],
                            "type": "string",
                            "title": "权限",
                            "default": "rw"
                        },
                        "host_path": {
                            "type": "string",
                            "title": "本地路径",
                            "format": "directory"
                        },
                        "container_path": {
                            "type": "string",
                            "title": "容器路径"
                        }
                    }
                },
                "title": "存储空间设置",
                "default": [
                    {
                        "mode": "rw",
                        "host_path": "/var/run/docker.sock",
                        "container_path": "/var/run/docker.sock"
                    },
                    {
                        "mode": "rw",
                        "host_path": "dockercopilot/data",
                        "container_path": "/data"
                    }
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": true,
                "description": "官方部署方式要求开启特权模式以正常管理容器"
            },
            "dockercopilot_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "key",
                        "value"
                    ],
                    "properties": {
                        "key": {
                            "type": "string",
                            "title": "变量名"
                        },
                        "value": {
                            "type": "string",
                            "title": "值"
                        }
                    }
                },
                "title": "环境变量",
                "default": [
                    {
                        "key": "TZ",
                        "value": "Asia/Shanghai"
                    },
                    {
                        "key": "DOCKER_HOST",
                        "value": "unix:///var/run/docker.sock"
                    },
                    {
                        "key": "secretKey",
                        "value": "pleaseChangeMe"
                    }
                ]
            }
        }
    },
    "yaml_template": "services:\n  dockercopilot:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in dockercopilot_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
    "readme": "# DockerCopilot\n\nDockerCopilot 是一款主打便捷的 Docker 容器管理工具，可在保留容器配置的情况下一键更新容器所使用的镜像，并支持容器启停、重命名、清理无 tag 镜像、备份与恢复容器设置。\n\n## 部署前准备\n\n1. 「存储空间设置」中已默认挂载 `/var/run/docker.sock`（必需）和数据目录 `/data`。\n2. 环境变量 `secretKey` 是面板登录密码，**必须修改为自己的密码**：不少于八位且不能是纯数字。\n3. 官方部署方式要求开启「特权模式」，默认已开启。\n\n## 使用\n\n1. 部署完成后访问 `http://<NAS-IP>:12712`。\n2. 使用 `secretKey` 设置的密码登录，即可查看各容器镜像更新情况并一键升级。\n\n## 注意\n\n该工具会直接重建容器，更新前建议先在面板中备份容器配置；请勿将面板端口暴露到公网。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": [
        "/data"
    ],
    "is_builtin": false
}
