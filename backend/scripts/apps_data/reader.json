{
    "name": "reader",
    "display_name": "Reader",
    "description": "Reader 是「阅读 3」的服务器版，支持书源导入、全网搜书、追更换源，提供 Web 端小说阅读体验，支持多用户。",
    "category": "book",
    "tags": [
        "图书",
        "小说",
        "书源",
        "在线阅读",
        "开源"
    ],
    "website": "https://github.com/hectorqin/reader",
    "source_url": "https://github.com/hectorqin/reader",
    "architectures": [
        "amd64",
        "arm64"
    ],
    "image": "hectorqin/reader",
    "default_ports": [
        {
            "port": 8080,
            "protocol": "tcp",
            "description": "Web 阅读界面"
        }
    ],
    "config_schema": {
        "type": "object",
        "required": [
            "ports",
            "volumes",
            "reader_env"
        ],
        "containers": [
            {
                "name": "reader",
                "title": "Reader",
                "settings": [
                    {
                        "type": "ports",
                        "title": "端口设置",
                        "fields": [
                            "ports"
                        ]
                    },
                    {
                        "type": "volumes",
                        "title": "存储空间设置",
                        "fields": [
                            "volumes"
                        ]
                    },
                    {
                        "type": "env",
                        "title": "环境变量",
                        "fields": [
                            "reader_env"
                        ]
                    },
                    {
                        "type": "advanced",
                        "title": "高级设置",
                        "fields": [
                            "privileged"
                        ]
                    }
                ],
                "description": "Reader 小说阅读服务器"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "local_port",
                        "container_port",
                        "protocol"
                    ],
                    "properties": {
                        "protocol": {
                            "enum": [
                                "tcp",
                                "udp"
                            ],
                            "type": "string",
                            "title": "协议",
                            "default": "tcp"
                        },
                        "local_port": {
                            "type": "integer",
                            "title": "本地端口",
                            "maximum": 65535,
                            "minimum": 1
                        },
                        "container_port": {
                            "type": "integer",
                            "title": "容器端口",
                            "maximum": 65535,
                            "minimum": 1
                        }
                    }
                },
                "title": "端口设置",
                "default": [
                    {
                        "protocol": "tcp",
                        "local_port": 8080,
                        "container_port": 8080
                    }
                ]
            },
            "volumes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "host_path",
                        "container_path",
                        "mode"
                    ],
                    "properties": {
                        "mode": {
                            "enum": [
                                "rw",
                                "ro"
                            ],
                            "type": "string",
                            "title": "权限",
                            "default": "rw"
                        },
                        "host_path": {
                            "type": "string",
                            "title": "本地路径",
                            "format": "directory"
                        },
                        "container_path": {
                            "type": "string",
                            "title": "容器路径"
                        }
                    }
                },
                "title": "存储空间设置",
                "default": [
                    {
                        "mode": "rw",
                        "host_path": "reader/logs",
                        "container_path": "/logs"
                    },
                    {
                        "mode": "rw",
                        "host_path": "reader/storage",
                        "container_path": "/storage"
                    }
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": false,
                "description": "一般情况下无需开启，仅当应用需要访问宿主机硬件设备时启用"
            },
            "reader_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "key",
                        "value"
                    ],
                    "properties": {
                        "key": {
                            "type": "string",
                            "title": "变量名"
                        },
                        "value": {
                            "type": "string",
                            "title": "值"
                        }
                    }
                },
                "title": "环境变量",
                "default": [
                    {
                        "key": "TZ",
                        "value": "Asia/Shanghai"
                    }
                ]
            }
        }
    },
    "yaml_template": "services:\n  reader:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in reader_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
    "readme": "# Reader\n\nReader 是「阅读 3」的服务器版，把全网小说资源整合成你的私人书库：支持书源管理、书架同步、搜索追更、换源，Web 端适配移动端浏览器。\n\n## 部署前准备\n\n1. 在「存储空间设置」中确认 `/logs`（运行日志）与 `/storage`（书源、书架等数据）的本地路径。\n2. 部署完成后访问 `http://<NAS-IP>:8080`，首次使用请注册账号。\n\n## 提示\n\n安装后进入「书源管理」导入书源文件，即可开始搜索和阅读小说。数据保存在 `/storage` 目录，迁移时备份该目录即可。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": [
        "/storage"
    ],
    "is_builtin": false
}