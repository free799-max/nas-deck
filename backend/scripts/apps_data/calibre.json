{
    "name": "calibre",
    "display_name": "Calibre",
    "description": "Calibre 是功能强大的一站式电子书管理工具，支持书库管理、格式转换与编辑；本镜像在容器中运行 Calibre 桌面界面，可直接通过浏览器访问使用。",
    "category": "book",
    "tags": [
        "图书",
        "电子书",
        "书库管理",
        "格式转换",
        "开源"
    ],
    "website": "https://calibre-ebook.com/",
    "source_url": "https://github.com/kovidgoyal/calibre",
    "architectures": [
        "amd64",
        "arm64"
    ],
    "image": "linuxserver/calibre",
    "default_ports": [
        {
            "port": 8080,
            "protocol": "tcp",
            "description": "Calibre 网页桌面界面"
        },
        {
            "port": 8081,
            "protocol": "tcp",
            "description": "Calibre 内容服务器"
        }
    ],
    "config_schema": {
        "type": "object",
        "required": [
            "ports",
            "volumes",
            "calibre_env"
        ],
        "containers": [
            {
                "name": "calibre",
                "title": "Calibre",
                "settings": [
                    {
                        "type": "ports",
                        "title": "端口设置",
                        "fields": [
                            "ports"
                        ]
                    },
                    {
                        "type": "volumes",
                        "title": "存储空间设置",
                        "fields": [
                            "volumes"
                        ]
                    },
                    {
                        "type": "env",
                        "title": "环境变量",
                        "fields": [
                            "calibre_env"
                        ]
                    },
                    {
                        "type": "advanced",
                        "title": "高级设置",
                        "fields": [
                            "privileged"
                        ]
                    }
                ],
                "description": "Calibre 电子书管理（Web 桌面版）"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "local_port",
                        "container_port",
                        "protocol"
                    ],
                    "properties": {
                        "protocol": {
                            "enum": [
                                "tcp",
                                "udp"
                            ],
                            "type": "string",
                            "title": "协议",
                            "default": "tcp"
                        },
                        "local_port": {
                            "type": "integer",
                            "title": "本地端口",
                            "maximum": 65535,
                            "minimum": 1
                        },
                        "container_port": {
                            "type": "integer",
                            "title": "容器端口",
                            "maximum": 65535,
                            "minimum": 1
                        }
                    }
                },
                "title": "端口设置",
                "default": [
                    {
                        "protocol": "tcp",
                        "local_port": 8080,
                        "container_port": 8080
                    },
                    {
                        "protocol": "tcp",
                        "local_port": 8081,
                        "container_port": 8081
                    }
                ]
            },
            "volumes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "host_path",
                        "container_path",
                        "mode"
                    ],
                    "properties": {
                        "mode": {
                            "enum": [
                                "rw",
                                "ro"
                            ],
                            "type": "string",
                            "title": "权限",
                            "default": "rw"
                        },
                        "host_path": {
                            "type": "string",
                            "title": "本地路径",
                            "format": "directory"
                        },
                        "container_path": {
                            "type": "string",
                            "title": "容器路径"
                        }
                    }
                },
                "title": "存储空间设置",
                "default": [
                    {
                        "mode": "rw",
                        "host_path": "calibre/config",
                        "container_path": "/config"
                    },
                    {
                        "mode": "rw",
                        "host_path": "calibre/books",
                        "container_path": "/books"
                    }
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": false,
                "description": "一般情况下无需开启，仅当应用需要访问宿主机硬件设备时启用"
            },
            "calibre_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "key",
                        "value"
                    ],
                    "properties": {
                        "key": {
                            "type": "string",
                            "title": "变量名"
                        },
                        "value": {
                            "type": "string",
                            "title": "值"
                        }
                    }
                },
                "title": "环境变量",
                "default": [
                    {
                        "key": "PUID",
                        "value": "1000"
                    },
                    {
                        "key": "PGID",
                        "value": "1000"
                    },
                    {
                        "key": "TZ",
                        "value": "Asia/Shanghai"
                    }
                ]
            }
        }
    },
    "yaml_template": "services:\n  calibre:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in calibre_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
    "readme": "# Calibre\n\nCalibre 是功能强大且简单易用的电子书管理器，完全免费开源。本镜像基于 LinuxServer.io 的 Selkies 方案，将 Calibre 桌面界面以网页形式串流到你的浏览器。\n\n## 部署前准备\n\n1. 在「环境变量」中确认 `PUID` / `PGID` 为宿主机上拥有书库目录读写权限的用户和组，默认为 `1000` / `1000`。\n2. 在「存储空间设置」中确认 `/config`（应用配置）与 `/books`（Calibre 书库）的本地路径。\n3. 部署完成后访问 `http://<NAS-IP>:8080` 即可看到 Calibre 桌面界面。\n\n## 端口说明\n\n- `8080`：Calibre 网页桌面界面。\n- `8081`：Calibre 自带的内容服务器（可在 Calibre 内开启后对外提供书库访问）。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": [
        "/config"
    ],
    "is_builtin": false
}