{
    "name": "calibre-web",
    "display_name": "Calibre-Web",
    "description": "Calibre-Web 是一个简洁优雅的 Web 应用，可基于现有的 Calibre 书库浏览、阅读与下载电子书，支持多用户与在线阅读。",
    "category": "book",
    "tags": [
        "图书",
        "电子书",
        "在线阅读",
        "书库管理",
        "开源"
    ],
    "website": "https://github.com/janeczku/calibre-web",
    "source_url": "https://github.com/janeczku/calibre-web",
    "architectures": [
        "amd64",
        "arm64"
    ],
    "image": "linuxserver/calibre-web",
    "default_ports": [
        {
            "port": 8083,
            "protocol": "tcp",
            "description": "Web 界面"
        }
    ],
    "config_schema": {
        "type": "object",
        "required": [
            "ports",
            "volumes",
            "calibre_web_env"
        ],
        "containers": [
            {
                "name": "calibre-web",
                "title": "Calibre-Web",
                "settings": [
                    {
                        "type": "ports",
                        "title": "端口设置",
                        "fields": [
                            "ports"
                        ]
                    },
                    {
                        "type": "volumes",
                        "title": "存储空间设置",
                        "fields": [
                            "volumes"
                        ]
                    },
                    {
                        "type": "env",
                        "title": "环境变量",
                        "fields": [
                            "calibre_web_env"
                        ]
                    },
                    {
                        "type": "advanced",
                        "title": "高级设置",
                        "fields": [
                            "privileged"
                        ]
                    }
                ],
                "description": "Calibre-Web 电子书在线阅读"
            }
        ],
        "properties": {
            "ports": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "local_port",
                        "container_port",
                        "protocol"
                    ],
                    "properties": {
                        "protocol": {
                            "enum": [
                                "tcp",
                                "udp"
                            ],
                            "type": "string",
                            "title": "协议",
                            "default": "tcp"
                        },
                        "local_port": {
                            "type": "integer",
                            "title": "本地端口",
                            "maximum": 65535,
                            "minimum": 1
                        },
                        "container_port": {
                            "type": "integer",
                            "title": "容器端口",
                            "maximum": 65535,
                            "minimum": 1
                        }
                    }
                },
                "title": "端口设置",
                "default": [
                    {
                        "protocol": "tcp",
                        "local_port": 8083,
                        "container_port": 8083
                    }
                ]
            },
            "volumes": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "host_path",
                        "container_path",
                        "mode"
                    ],
                    "properties": {
                        "mode": {
                            "enum": [
                                "rw",
                                "ro"
                            ],
                            "type": "string",
                            "title": "权限",
                            "default": "rw"
                        },
                        "host_path": {
                            "type": "string",
                            "title": "本地路径",
                            "format": "directory"
                        },
                        "container_path": {
                            "type": "string",
                            "title": "容器路径"
                        }
                    }
                },
                "title": "存储空间设置",
                "default": [
                    {
                        "mode": "rw",
                        "host_path": "calibre-web/config",
                        "container_path": "/config"
                    },
                    {
                        "mode": "rw",
                        "host_path": "calibre-web/books",
                        "container_path": "/books"
                    }
                ]
            },
            "privileged": {
                "type": "boolean",
                "title": "特权模式",
                "default": false,
                "description": "一般情况下无需开启，仅当应用需要访问宿主机硬件设备时启用"
            },
            "calibre_web_env": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "key",
                        "value"
                    ],
                    "properties": {
                        "key": {
                            "type": "string",
                            "title": "变量名"
                        },
                        "value": {
                            "type": "string",
                            "title": "值"
                        }
                    }
                },
                "title": "环境变量",
                "default": [
                    {
                        "key": "PUID",
                        "value": "1000"
                    },
                    {
                        "key": "PGID",
                        "value": "1000"
                    },
                    {
                        "key": "TZ",
                        "value": "Asia/Shanghai"
                    }
                ]
            }
        }
    },
    "yaml_template": "services:\n  calibre-web:\n    image: {{ image }}\n    container_name: {{ project_name }}\n    ports:\n{%- for port in ports %}\n      - \"{{ port.local_port }}:{{ port.container_port }}/{{ port.protocol }}\"\n{%- endfor %}\n    volumes:\n{%- for vol in volumes %}\n      - {{ to_host_path(vol.host_path if (vol.host_path.startswith('/') or vol.shared) else project_name ~ '/' ~ vol.host_path) }}:{{ vol.container_path }}:{{ vol.mode }}\n{%- endfor %}\n    privileged: {{ privileged | lower }}\n    restart: unless-stopped\n    environment:\n{%- for item in calibre_web_env %}\n      - {{ item.key }}={{ item.value }}\n{%- endfor %}\n",
    "readme": "# Calibre-Web\n\nCalibre-Web 是一个 Web 应用，提供简洁的界面来浏览、阅读和下载电子书，它使用现有的 Calibre 数据库。注意：它不是 Calibre 的替代品，书库需要先由 Calibre 创建并初始化。\n\n## 部署前准备\n\n1. 先用 Calibre（或本应用市场里的 Calibre 应用）在书库目录中初始化 `metadata.db`，再把该目录挂载到 `/books`。\n2. 在「环境变量」中确认 `PUID` / `PGID` 为宿主机上拥有书库读写权限的用户和组。\n3. 部署完成后访问 `http://<NAS-IP>:8083`，默认账号 `admin`、密码 `admin123`，请登录后立即修改。\n\n## 提示\n\n若 `/books` 以只读（ro）挂载，部分功能（如上传书籍）将不可用。",
    "version": "1.0.0",
    "type": "compose",
    "changelog": "初始导入",
    "backup_paths": [
        "/config"
    ],
    "is_builtin": false
}